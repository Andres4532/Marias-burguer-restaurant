{
  "name": "sistema-restaurante",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w api\" \"npm run dev -w web\"",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File scripts/clean-dev.ps1",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w api && npm run build -w web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate -w api",
    "db:deploy": "npm run prisma:deploy -w api",
    "db:seed": "npm run prisma:seed -w api",
    "db:studio": "npm run prisma:studio -w api",
    "db:reset": "npm run prisma:reset -w api",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-db.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
